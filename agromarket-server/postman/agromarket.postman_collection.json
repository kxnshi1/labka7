{
  "info": {
    "name": "AgroMarket Lab 7",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Перед запуском задайте adminPassword локально из .env. Runner создаёт тестового пользователя и заявку."
  },
  "item": [
    {
      "name": "01 Health",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/health",
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200',()=>pm.response.to.have.status(200));",
              "pm.test('DB connected',()=>pm.expect(pm.response.json().db).to.eql('connected'));"
            ]
          }
        }
      ]
    },
    {
      "name": "02 Вход администратора",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/auth/login",
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{\"email\": \"{{adminEmail}}\", \"password\": \"{{adminPassword}}\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200',()=>pm.response.to.have.status(200));",
              "if(pm.response.code===200){const d=pm.response.json();pm.collectionVariables.set('token',d.token);pm.test('admin',()=>pm.expect(d.user.role).to.eql('admin'));}else pm.collectionVariables.unset('token');"
            ]
          }
        }
      ]
    },
    {
      "name": "03 Регистрация",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/auth/register",
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{\"name\": \"Тест\", \"email\": \"{{userEmail}}\", \"password\": \"{{userPassword}}\", \"role\": \"admin\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set('userEmail','lab7-'+pm.variables.replaceIn('{{$guid}}')+'@test.kz');"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 201',()=>pm.response.to.have.status(201));",
              "const d=pm.response.json();pm.test('role user; no hash',()=>{pm.expect(d.user.role).to.eql('user');pm.expect(d.user).not.to.have.property('password_hash');});"
            ]
          }
        }
      ]
    },
    {
      "name": "04 Повторная регистрация",
      "request": {
        "method": "POST",
        "header": [
