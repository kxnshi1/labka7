    {
      "name": "вход администратора",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Статус 200', () => {\r\n  pm.response.to.have.status(200);\r\n});\r\n\r\nif (pm.response.code === 200) {\r\n  const data = pm.response.json();\r\n\r\n  pm.test('Роль — admin', () => {\r\n    pm.expect(data.user.role).to.eql('admin');\r\n  });\r\n\r\n  pm.test('Хэш пароля не передаётся', () => {\r\n    pm.expect(data.user).to.not.have.property('password_hash');\r\n  });\r\n\r\n  pm.test('Сервер выдал токен', () => {\r\n    pm.expect(data.token).to.be.a('string').and.not.empty;\r\n  });\r\n\r\n  pm.collectionVariables.set('token', data.token);\r\n} else {\r\n  pm.collectionVariables.unset('token');\r\n}"
            ]
          }
        }
      ],
